{
  "name": "wheel-zk",
  "private": true,
  "type": "module",
  "description": "The Wheel's anonymous members: a Semaphore group and fixed-per-event show-up proofs. State note: ../README.md, Profiles.",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/*.test.mjs",
    "build": "esbuild client/wheel-client.mjs --bundle --format=iife --platform=browser --target=es2020 --minify --legal-comments=eof --outfile=dist/wheel-zk.js"
  },
  "dependencies": {
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
