{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-hub/event.schema.json",
  "title": "Event",
  "description": "One event as the hub holds it. Draft 3, 2026-10-20 (modes; volunteer calls with shifts; tags as centre + reach; depositor). Field names follow Meetable's add-event API where they overlap, so a record can be posted there unchanged if Meetable is chosen as the hub.",
  "type": "object",
  "required": [
    "id",
    "name",
    "start_date",
    "timezone",
    "source",
    "review",
    "modes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable hub id (hash of source kind + source id or url + start)."
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "One line for the list card."
    },
    "description": {
      "type": "string",
      "description": "The organiser's own words, trimmed. Never the full raw post."
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-2][0-9]:[0-5][0-9]$",
      "description": "Null = all day or unknown; see time_known."
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "end_time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-2][0-9]:[0-5][0-9]$"
    },
    "time_known": {
      "type": "boolean",
      "description": "False when the source gave a date only. DormSoup guessed 60 minutes; we mark the gap."
    },
    "timezone": {
      "type": "string",
      "default": "Pacific/Auckland",
      "description": "Always explicit. DormSoup stored naive local time labelled UTC."
    },
    "recurrence": {
      "type": [
        "string",
        "null"
      ],
      "description": "The source's own words (\"every Thursday 5pm\"); an RRULE may be derived later. DormSoup had none."
    },
    "status": {
      "enum": [
        "confirmed",
        "tentative",
        "postponed",
        "cancelled"
      ],
      "default": "confirmed",
      "description": "Meetable's four values. A later post saying 'cancelled' updates this."
    },
    "location_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "location_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "location_locality": {
      "type": [
        "string",
        "null"
      ],
      "description": "Suburb or town: Orewa, Browns Bay, Matakana."
    },
    "location_region": {
      "type": [
        "string",
        "null"
      ],
      "default": "Auckland"
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "online": {
      "type": "boolean",
      "default": false
    },
    "organiser": {
      "type": [
        "string",
        "null"
      ],
      "description": "As the organiser names themselves."
    },
    "price": {
      "type": [
        "string",
        "null"
      ],
      "description": "As written: \"koha\", \"free\", \"$25\"."
    },
    "website": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "The organiser's own page for the event. Every listing links here."
    },
    "tickets_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "cover_image": {
      "type": [
        "string",
        "null"
      ],
      "description": "Local copy path or url; only with the organiser's flyer as source."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag ids (tag.schema.json). Area tags are added automatically when the event's coordinates fall inside an area's reach; kind tags come from the depositor and the reader."
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deposit",
            "ics",
            "jsonld",
            "facebook",
            "instagram",
            "web",
            "forward",
            "manual"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "ICS UID, Facebook event id, Instagram shortcode."
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "raw_sha256": {
          "type": "string",
          "description": "Hash of the raw input, so a re-run can tell an edit from a repeat."
        }
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "ics",
            "jsonld",
            "facebook",
            "llm",
            "hand"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stamped like DormSoup's modelName, so a better prompt can re-run old rows."
        },
        "confidence_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ],
      "description": "Calagator's pattern: a merged duplicate keeps its row and points at the original."
    },
    "deposited_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Who deposited it (his call 1: users are the source). Kept as little as the deposit rule allows."
    },
    "listing_kind": {
      "enum": [
        "event",
        "volunteer"
      ],
      "default": "event",
      "description": "A volunteer call has shifts to fill (his call, 2026-10-20: time slots and task requirements)."
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "day",
          "night",
          "recovery"
        ]
      },
      "description": "His three modes, each its own view. Recovery can sit beside Day or Night; anything over several days carries Day and Night; a multi-day retreat carries all three."
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          },
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "needed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "description": "Volunteer calls only: one entry per shift."
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Volunteer calls only: what the post asks for, in its own words."
    }
  }
}
